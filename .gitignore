__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.DS_Store

# Claude Code machine-local settings (never commit); the project-level
# skill under .claude/skills/ IS versioned and tracked.
.claude/settings.local.json

# Run outputs (per-prompt + summaries)
results/**/raw.jsonl
results/**/raw.v2.jsonl
results/**/summary.json
results/**/submitted_jobs.json
results/**/check_status.json
results/summary/*.csv
# Note: results/analysis/*.{json,csv} are intentionally tracked — they are the
# pipeline ground truth (pair_interpretations, pairwise_deltas, summary) and
# the source of the interpretation labels that appear in the FYP report.

# T18 multi-seed sensitivity arm: raw generations (contain harmful prompt/
# response text) and judge sidecars stay local. Only the redacted aggregate
# results/analysis/sensitivity_multiseed.{json,csv} is committed.
results_sensitivity/
# T31/D39: 512-token multi-seed arm (same local-only policy as results_sensitivity/)
results_sensitivity_512/

# T31/D39 512-token generation-length rerun arm: same policy as results/ —
# raw generations + summaries stay local (harmful text), redacted judge sidecars
# and results_512/analysis/* are the only tracked artifacts.
results_512/**/raw.jsonl
results_512/**/raw.v2.jsonl
results_512/**/summary.json
results_512/**/submitted_jobs.json
results_512/**/check_status.json
results_512/summary/*.csv
results_512/slurm_logs*/

# SLURM logs for any cluster variant (slurm_logs, slurm_logs_tc1, ...)
results/slurm_logs*/

# Generated SLURM artifacts
slurm/*.json
slurm/jobs*/manifest.json
slurm/jobs*/submitted_jobs.json
# slurm/jobs/ is the legacy job directory (pre-TC1 restructure); ignore its sbatch files.
# Active jobs live in slurm/jobs_tc1/ and slurm/jobs_tc1_smoke/ (tracked in git).
slurm/jobs/*.sbatch

# Editor / IDE / OS caches not relevant to this repo
.swift-cache/
pdfthumbs/
terminal_log*.txt

# Word lock files (created by Word when a doc is open)
~$*.docx
~$*.html

# Generated FYP documents are NOT committed (2026-08-10). The repository is
# public, and a publicly indexed copy of a report that has not yet been submitted
# can be returned as a similarity match against the student's own submission.
# The builders under scripts/ remain tracked and regenerate every document, so
# nothing is lost: run `make report`, `make thesis`, or the rewrite/interim
# builders after cloning. Surfaces are marked `gitignored_optional` in
# configs/claim_surfaces.yaml so the gates check them locally and skip on a clone.
#
# NOTE: removing these files from tracking does NOT remove them from git history,
# and the builders themselves contain the full prose. Making the repository
# private is the only measure that actually withdraws the text.
docs/*.docx
docs/archive/*.docx
# NTU-supplied documents (cluster user guide, FYP application form)
docs/CCDSGPU-TC1-*.pdf

# Supervisor correspondence drafts — keep local, never commit
docs/email_*.md

# Python packaging build artifacts (from pip install -e .)
*.egg-info/

# Node dependencies — local @resvg/resvg-js (figure rasteriser for
# scripts/build_agentic_report.js). package.json + package-lock.json ARE tracked
# so the dependency is recorded; restore the platform binary with `npm install`.
node_modules/

# Human-label audit: annotation sheet contains raw prompt/response text — local only.
# Only the redacted aggregate results/analysis/human_validation.json is committed.
human_labels/

# FYP submission staging package (contains private email drafts) — keep local
fyp_submission/

# Dashboard (dashboard/app.py) scratch outputs: user-scaffolded configs and the
# sbatch they generate are working files, not committed artifacts. Force-add a
# specific one (git add -f) if you decide to keep it.
configs/generated/
slurm/jobs_generated/
results_dev/

# pytest-cov by-product
.coverage
.local_build_state

# Third-party reference corpus: past students' FYP reports and copyrighted papers.
# Read locally for the corpus style study and the claim-fitness audits; never
# redistributed — this repository is public.
Examples of Past FYP Papers/

# Consolidated copies of the cited papers, one PDF per reference in the interim
# report (see Sources/README.md). Same third-party copyright position as the line
# above, and ~194 MB that git history could not easily shed if it were committed.
Sources/

# Report version change records that quote report prose wholesale. The committed
# .summary.md siblings cap quotes at 90 chars; these full extracts stay local so
# the public repository never republishes submission text (same rationale as the
# docs/**/*.docx rule from D60).
docs/report_versions/changes/*.full.md
docs/report_versions/changes/*.full.json

# AETHERIA Three.js world (world3d/) — build/run outputs stay local; the app
# source, package.json and e2e suite are tracked. Screenshots regenerate via
# `npm run test:e2e`.
world3d/dist/
world3d/.npm-cache/
world3d/.chrome-tmp/
world3d/screenshots/

# Scratch/working tree for audits and document renders: PDF/text extractions of
# the built docx, per-audit chunk dumps, an ephemeral Chrome profile, and copies
# of third-party source PDFs. All of it is regenerable from the builders and the
# audit scripts, and some of it carries the same third-party-copyright and
# submission-text concerns as the Sources/ and docs/**/*.docx rules above.
tmp/

# Personal learning scaffold (learn-by-grilling) — not part of the deliverable
learning/

# D94 (2026-09-26): reports and presentations are local-only. The builders embed
# the full report prose, so they are ignored alongside the rendered documents,
# decks and showcase pages. This applies going forward only: commits made before
# D94 still contain earlier versions. Never `git add -f` these paths.
docs/**/*.docx
docs/**/*.pptx
docs/**/*.html
docs/viva/
docs/drafts/
docs/report_versions/*.summary.md
docs/report_versions/changes/*.summary.md
scripts/build_fyp_*.js
scripts/build_rewritten_fyp_*.py
scripts/rewrite_submitted_literature_review.py
scripts/build_agentic_report.js
scripts/build_agent_harness_architecture_doc.py
scripts/build_viva_deck.py
scripts/build_viva_deck_html.py
scripts/build_fyp_explainer_deck.js
scripts/build_showcase_latentspace.py
scripts/report_tools/apply_audit_fixes.py
scripts/report_tools/pass*.py
scripts/report_tools/build_v4_source_entailment_*.py
world3d/
